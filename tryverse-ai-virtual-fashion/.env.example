# Copy to .env and fill in values.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend API (Contact form, early access, try-on, etc.)
VITE_BACKEND_URL=http://localhost:3001

# Invite signup: keep unset or "false" while only waitlist is open.
# Set to "true" when you want approved brands to use /auth?signup=true to create accounts.
# VITE_ENABLE_INVITE_SIGNUP=true
