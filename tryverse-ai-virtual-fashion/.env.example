# Copy to .env and fill in values.

# Convex — deploy URL from `npx convex dev` / dashboard, e.g. https://happy-animal-123.convex.cloud
# VITE_CONVEX_URL=

# Convex dashboard (server env, not Vite): password reset email
# AUTH_RESEND_KEY — https://resend.com/api-keys
# Optional: AUTH_EMAIL_FROM — verified sender, e.g. TryVerse <auth@yourdomain.com>

# Backend API (try-on, uploads, etc.)
# Local dev: leaving this unset OR setting http://localhost:3001 both use Vite’s proxy (browser → :8080 → :3001).
# Set a different URL only if the API is not on localhost:3001 during development.
# Production / split hosts: set your real API origin.
# VITE_BACKEND_URL=https://api.yourdomain.com

# Brand self-serve signup: allowed by default. Set to "false" to require waitlist + invite only.
# VITE_ENABLE_INVITE_SIGNUP=false

# Personal (B2C) signup at /auth?signup=individual — set to "false" to pause.
# VITE_ENABLE_B2C_SIGNUP=false
