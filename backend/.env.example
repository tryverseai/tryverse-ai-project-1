# ════════════════════════════════════════════════════════════════
#  TRYVERSE BACKEND — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env or real secrets to version control.
#  See SECURITY.md for full security guidelines.
# ════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local dev: redis://localhost:6379
# Production: redis://:<password>@your-redis-host:6379
REDIS_URL=redis://localhost:6379

# ─── Replicate AI ─────────────────────────────────────────────────────────────
# Get API token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# Model overrides — defaults are pre-configured, only set if you want to change
# REPLICATE_MODEL_CLOTHING=cuuupid/idm-vton:c871bb9b046607b680449ecbae55fd8c6d945e0a1948644bf2361b3d021d3ff4
# REPLICATE_MODEL_ACCESSORIES=fashn/tryon:54bb2780ade1e2584e29a1b634a59571e59ddc65958fcfad8514a30c7d5d4ea5
# REPLICATE_MODEL_REMBG=lucataco/remove-bg:95fcc2a26d3899cd6c2691c900465aaeff466285d65c14638e98ef4f5d22dcfa
# REPLICATE_MODEL_GFPGAN=tencentarc/gfpgan:9283608cc6b7be6b65a8e44983db012355f67302c51d70fbc95d863a95a4c85

# ─── Pipeline Feature Flags ───────────────────────────────────────────────────
# Enable/disable each processing stage independently
ENABLE_BACKGROUND_REMOVAL=true          # Remove bg from product image before AI
ENABLE_BACKGROUND_NORMALIZATION=false   # Normalize person image background
ENABLE_FACE_PRESERVATION=true           # Restore face after AI generation (GFPGAN)
ENABLE_POST_PROCESSING=true             # Color/lighting/shadow correction (Sharp)
ENABLE_IMAGE_MODERATION=false           # Hive content moderation (requires HIVE_API_KEY)

# ─── Image Moderation (Hive) ──────────────────────────────────────────────────
# Sign up at: https://hivemoderation.com
# Leave empty to disable moderation (not recommended for production)
HIVE_API_KEY=

# ─── CDN (Cloudflare) ─────────────────────────────────────────────────────────
# Set up a Cloudflare proxy in front of your Supabase Storage bucket:
#   1. Add a CNAME record: cdn.yourdomain.com → your-project.supabase.co
#   2. Enable Cloudflare proxy (orange cloud)
#   3. Set CLOUDFLARE_CDN_DOMAIN to your CDN domain
CLOUDFLARE_CDN_DOMAIN=                  # e.g. cdn.tryverse.ai
CLOUDFLARE_ZONE_ID=                     # For cache purging (optional)
CLOUDFLARE_API_TOKEN=                   # For cache purging (optional)
CLOUDFLARE_IMAGE_RESIZING_ENABLED=false # Enable Cloudflare Image Resizing (paid feature)

# ─── Error Monitoring (Sentry) ────────────────────────────────────────────────
# Sign up at: https://sentry.io
# Create a Node.js project → copy the DSN
SENTRY_DSN=                             # e.g. https://xxx@sentry.io/123

# ─── Payments (Paystack) ──────────────────────────────────────────────────────
# Get from: https://dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ─── Payments (Flutterwave) ───────────────────────────────────────────────────
# Get from: https://dashboard.flutterwave.com → Settings → API Keys
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_key
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_BUCKET_INPUTS=tryon-inputs      # Private bucket for uploaded photos
STORAGE_BUCKET_RESULTS=tryon-results    # Public bucket for generated results
IMAGE_EXPIRY_SECONDS=3600               # Signed URL expiry (1 hour default)

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a strong random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY=your_very_strong_admin_secret_key_here

# Comma-separated allowed origins for widget embeds (* = allow all)
WIDGET_ALLOWED_ORIGINS=*

# ─── Job Queue ────────────────────────────────────────────────────────────────
JOB_CONCURRENCY=3         # Parallel AI jobs per worker
JOB_TIMEOUT_MS=180000     # 3 minutes max per job
JOB_MAX_RETRIES=3         # Retry failed jobs this many times
