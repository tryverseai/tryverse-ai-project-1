# ════════════════════════════════════════════════════════════════
#  TRYVERSE BACKEND — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env or real secrets to version control.
#  See SECURITY.md for full security guidelines.
# ════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Frontend URL (for CORS). Also used to resolve path-only model library image_url values
# (e.g. /model-library/zoe.png → http://localhost:8080/model-library/zoe.png).
FRONTEND_URL=http://localhost:8080

# Optional: public site URL for links in waitlist confirmation emails (/book-demo, footer).
# If unset, FRONTEND_URL is used. Production API often needs: PUBLIC_APP_URL=https://tryverseai.com
# while FRONTEND_URL may still be localhost during dev.
# PUBLIC_APP_URL=https://tryverseai.com

# ─── Convex (required) ────────────────────────────────────────────────────────
# Deploy URL from: npx convex dashboard  OR  Convex dashboard → Settings → Deployment URL
# Example: https://happy-animal-123.convex.cloud
CONVEX_URL=
# Same random secret in Convex dashboard → Settings → Environment Variables → BACKEND_SHARED_SECRET
# (no leading/trailing spaces — must match exactly; both sides trim BOM/whitespace in code)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_SHARED_SECRET=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Waitlist + transactional mail from the Node backend use RESEND_API_KEY here.
# Sign-up / password reset from Convex Auth use AUTH_RESEND_KEY in the Convex dashboard
# (Settings → Environment Variables) — set both to the SAME active key from:
#   https://resend.com/api-keys  (must start with re_ — no quotes or spaces in .env)
# If Resend says "API key is invalid": create a new key in the dashboard; old keys stop working if rotated.
# Verify domain at: https://resend.com/domains
# Production: use a verified sender on your domain, e.g. TryVerse <info@tryverseai.com>
# Development/testing: TryVerse <onboarding@resend.dev> only delivers to your Resend account email until a domain is verified.
RESEND_API_KEY=
EMAIL_FROM=TryVerse <info@tryverseai.com>

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local dev: redis://localhost:6379
# Production: redis://:<password>@your-redis-host:6379
REDIS_URL=redis://localhost:6379

# ─── FASHN AI (direct API — preferred for FASHN try-ons) ─────────────────────
# Get API key from: https://fashn.ai → Dashboard → API Keys
# When set, ALL FASHN try-ons (clothing, bags, glasses) call api.fashn.ai directly
# instead of routing through Replicate. Leave empty to fall back to Replicate.
FASHN_API_KEY=

# ─── Replicate AI ─────────────────────────────────────────────────────────────
# Get API token from: https://replicate.com/account/api-tokens
# Still required for IDM-VTON (clothing fallback) and Flux Kontext.
REPLICATE_API_TOKEN=r8_your_replicate_token_here
# Min ms between Replicate calls (429 guard). Omit = 2000 dev / 10000 production.
# REPLICATE_MIN_GAP_MS=12000

# Clothing model — default is pinned IDM-VTON (single portrait output). OOT uses model_image + garment_image.
# REPLICATE_MODEL_CLOTHING=cuuupid/idm-vton:c871bb9b046607b680449ecbae55fd8c6d945e0a1948644bf2361b3d021d3ff4
# REPLICATE_MODEL_ACCESSORIES=fashn/tryon:54bb2780ade1e2584e29a1b634a59571e59ddc65958fcfad8514a30c7d5d4ea5
# REPLICATE_MODEL_REMBG=lucataco/remove-bg:95fcc2a26d3899cd6c2691c900465aaeff466285d65c14638e98ef4f5d22dcfa
# REPLICATE_MODEL_GFPGAN=tencentarc/gfpgan:9283608cc6b7be6b65a8e44983db012355f67302c51d70fbc95d863a95a4c85
# Optional human parsing (Replicate model accepting input: { image: "<https url>" } → image URL). Leave empty to skip.
# REPLICATE_MODEL_HUMAN_PARSE=
# REPLICATE_MODEL_FLUX_KONTEXT=flux-kontext-apps/multi-image-kontext-pro:...
# REPLICATE_USE_FLUX_KONTEXT=false     # If true, all clothing uses Flux (overrides hybrid routing below)

# ─── Pipeline Feature Flags ───────────────────────────────────────────────────
# Enable/disable each processing stage independently
TRYON_CLOTHING_SMART_FRAME=true        # Letterbox clothing try-on to 3:4; expand tight portraits so more garment visible
TRYON_CANONICAL_PERSON=true            # After smart-frame: force 768×1024 canvas before inference
TRYON_STRICT_PERSON_VALIDATION=true    # Reject 0 or 2+ faces, tiny images, very landscape crops (set false to skip BlazeFace gating)
TRYON_FULLBODY_USE_FLUX=false          # Off by default (Flux can return side-by-side collages). Enable only if needed.
TRYON_FULLBODY_FLUX_FALLBACK_IDM=true  # On Flux error, run IDM-VTON once
TRYON_CLOTHING_USE_FASHN=true          # Clothing via FASHN Try-On (same as fashn.ai-style quality); false = IDM-VTON only
TRYON_FASHN_FALLBACK_IDM=true          # On FASHN error, run IDM-VTON once
TRYON_FASHN_CATEGORY_AUTO=true         # Generic/empty product captions → FASHN category "auto" (avoids gowns routed as tops)
TRYON_FASHN_LIGHT_POST=true              # Skip heavy sharpen on FASHN output (kinder to faces)
TRYON_FASHN_FACE_LOCK=false           # Off: face/neck paste causes seams on light/sleeveless tops; use face-only patch if you enable
TRYON_FASHN_RESTORE_CLOTHES=false      # Off for clothing swap (avoids smear with old outfit); true only if you need accessory-style blend
# FASHN built-in NSFW check (default true). Set false if try-ons fail with “content policy” on benign photos (dev/testing only unless policy allows).
FASHN_NSFW_FILTER=true
ENABLE_BACKGROUND_REMOVAL=false         # Off recommended for IDM-VTON person context; on removes product bg only when enabled
ENABLE_BACKGROUND_NORMALIZATION=false   # Normalize person image background
ENABLE_FACE_PRESERVATION=false         # Deprecated — GFPGAN is not used by the pipeline (identity = face lock only)
ENABLE_FACE_LOCK=true                   # Clothing: paste face+neck from input onto output (BlazeFace + Sharp)
FACE_LOCK_NECK_EXTENSION_RATIO=0.28    # Neck band = this × face height (down — keep low to avoid pasting old outfit)
FACE_LOCK_BLEND_OPACITY=0.93           # Peak alpha for identity patch (0.85–0.99)
FACE_LOCK_FEATHER_MIN_PX=4               # Minimum edge feather (px)
FACE_LOCK_MAX_HEIGHT_FRAC=0.38         # Identity patch height cap (fraction of person height)
FACE_LOCK_MAX_WIDTH_FRAC=0.55          # Identity patch width cap (fraction of person width)
TRYON_IDENTITY_OUTPUT_MAD_THRESHOLD=2.75  # If VTON output ≈ person (mean abs diff), retry once with new seed
ENABLE_POST_PROCESSING=true             # Color/lighting/shadow correction (Sharp)
ENABLE_IMAGE_MODERATION=false           # Hive content moderation (requires HIVE_API_KEY)

# Try-on quality (retail / clarity)
TRYON_AI_MAX_DIMENSION=1024           # Longest edge for model input (768–1536)
TRYON_AI_JPEG_QUALITY=92                # JPEG quality for AI-bound images (85–98)
IDM_VTON_DENOISE_STEPS=50               # IDM-VTON diffusion steps (20–50)
IDM_VTON_GUIDANCE_SCALE=2               # IDM-VTON guidance / CFG (1–5, typical 2)
TRYON_POST_PROCESS_STYLE=natural        # natural = gentle touch (default) | vivid = stronger saturation/sharpen

# ─── Image Moderation (Hive) ──────────────────────────────────────────────────
# Sign up at: https://hivemoderation.com
# Leave empty to disable moderation (not recommended for production)
HIVE_API_KEY=

# ─── CDN (Cloudflare) ─────────────────────────────────────────────────────────
# Optional: proxy your image origin (e.g. Convex signed URL host or R2/custom origin) through Cloudflare.
#   1. CNAME cdn.yourdomain.com → your storage / worker hostname (per your setup)
#   2. Enable Cloudflare proxy (orange cloud)
#   3. Set CLOUDFLARE_CDN_DOMAIN below
CLOUDFLARE_CDN_DOMAIN=                  # e.g. cdn.tryverseai.com
CLOUDFLARE_ZONE_ID=                     # For cache purging (optional)
CLOUDFLARE_API_TOKEN=                   # For cache purging (optional)
CLOUDFLARE_IMAGE_RESIZING_ENABLED=false # Enable Cloudflare Image Resizing (paid feature)

# ─── Error Monitoring (Sentry) ────────────────────────────────────────────────
# Sign up at: https://sentry.io — Create Node.js (backend) and React (frontend) projects
SENTRY_DSN=                             # Backend DSN: https://xxx@xxx.ingest.sentry.io/123
SENTRY_ISSUES_URL=                      # Optional: link to Sentry Issues (e.g. https://sentry.io/organizations/org/issues/)

# ─── Payments (Paystack) ──────────────────────────────────────────────────────
# Get from: https://dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ─── Payments (Flutterwave) ───────────────────────────────────────────────────
# Get from: https://dashboard.flutterwave.com → Settings → API Keys
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_key
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret

# ─── Storage (logical bucket names; Convex + backend mapping) ─────────────────
# Used as labels in the Node API for Convex file storage paths. Match your deployment conventions.
STORAGE_BUCKET_INPUTS=tryon-inputs
STORAGE_BUCKET_RESULTS=tryon-results
IMAGE_EXPIRY_SECONDS=3600               # Signed URL expiry (1 hour default)

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a strong random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY=your_very_strong_admin_secret_key_here

# Cloudflare Turnstile — secret for POST /api/account/session/bootstrap (pairs with VITE_CLOUDFLARE_TURNSTILE_SITE_KEY). If unset, verification is skipped (not for production).
# CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Comma-separated allowed origins for pages that embed the widget / call the API from the browser.
# Development: * is OK. Production: * is rejected — use real URLs (custom OR platform host, e.g. https://myapp.up.railway.app).
# See docs/GOING_TO_PRODUCTION.md
WIDGET_ALLOWED_ORIGINS=*

# When you deploy, set FRONTEND_URL and WIDGET_ALLOWED_ORIGINS to your HTTPS app URL(s), e.g.:
#   FRONTEND_URL=https://tryverseai.com
#   WIDGET_ALLOWED_ORIGINS=https://tryverseai.com,https://partner-store.com

# Optional: API hostnames for HTTP→HTTPS redirect (comma-separated, no scheme). Use when API hostname ≠ FRONTEND_URL host.
# Example: api.tryverseai.com — set this if your API is on a different subdomain than the app.
PUBLIC_API_HOSTNAMES=

# Production: send API keys with x-api-key header only. true = allow ?api_key= (leaks in logs/referrers — avoid).
ALLOW_API_KEY_IN_QUERY=false

# ─── Try-on credits (dev) ───────────────────────────────────────────────────
# Development only — allows try-on without TryVerse plan credits. Replicate still bills your API key.
# Never set to true in production (server will refuse to start).
TRYON_SKIP_CREDIT_CHECK=false

# ─── Job Queue ────────────────────────────────────────────────────────────────
JOB_CONCURRENCY=3         # Parallel AI jobs per worker
JOB_TIMEOUT_MS=180000     # 3 minutes max per job
JOB_MAX_RETRIES=3         # Retry failed jobs this many times
